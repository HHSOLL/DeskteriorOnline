NEXT_PUBLIC_SUPABASE_URL=
# Use the Supabase publishable key (`sb_publishable_...`) for browser/public flows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep this populated in Vercel Preview/Production and store it as a Sensitive env var there.
RAILWAY_API_URL=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
E2E_RAILWAY_API_URL=
PROJECT_MEDIA_BUCKET=project-media
# Required in production/preview for snapshot upload/signing and owner-scope job lookup paths.
# Store the Supabase secret key (`sb_secret_...`) and mark it Sensitive in Vercel Preview/Production.
SUPABASE_SERVICE_ROLE_KEY=
